# Публічний API-ключ KeyCRM (Налаштування → Інші інтеграції → API)
KEYCRM_API_KEY=
# Піддомен KeyCRM: morningstar.keycrm.app → morningstar
KEYCRM_SUB=morningstar
# Технічний користувач KeyCRM (без двофакторної перевірки), від імені якого сервер читає переписку
KEYCRM_USER=
KEYCRM_PASS=
# Telegram: бот і чат, куди слати сповіщення воронки (можна той самий, що в J.A.R.V.I.S)
TG_BOT_TOKEN=
TG_CHAT_ID=
# Необов'язкове
FUNNEL_NAME=Monoclo · Свій принт
CYCLE_MINUTES=10
BRIEF_TIME=09:30
# Railway Volume, змонтований у /data (щоб стан не губився при перезапуску)
DATA_DIR=/data
